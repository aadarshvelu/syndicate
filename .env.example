# syndicate · environment template
#
# Copy to `.env` at the repo root and fill in the values you need. Skills
# that require missing vars will fail their preflight check (run
# `uv run python -m pipeline.cli status` to see which are present).
#
# Loading: pipeline/cli.py auto-loads this file from $REPO/.env on every
# subcommand invocation. Shell-exported vars take precedence.
#
# Required-by legend per stage:
#   [plugin]  – needed when invoking skills from a different cwd
#   [gmail]   – /syndicate-ingest-gmail
#   [rss]     – /syndicate-ingest-rss     (no creds, network-only)
#   [twitter] – /syndicate-ingest-twitter
#   [ai]      – /syndicate-summarize, /syndicate-dedup, /syndicate-link-relations
#   [export]  – /syndicate-export
#   [notify]  – /syndicate-notify         (and auto-notify on /syndicate-run)


# ── Plugin ──────────────────────────────────────────────────────────────────
# [plugin] Absolute path to the syndicate checkout. Required ONLY when you
# run skills from a directory other than the syndicate repo itself (e.g.
# after `claude --plugin-dir`-style install). Skills use this to resolve
# .env, db/snapshot.db, and logs/.
SYNDICATE_REPO=


# ── Gmail ingestion ─────────────────────────────────────────────────────────
# [gmail] IMAP login for the inbox that receives your newsletters. Use a
# dedicated Gmail account if possible — the app password grants IMAP read
# access to the whole mailbox.
GMAIL_USER=you@example.com
# [gmail] Google App Password (16 chars, no spaces). NOT your account
# password. Generate at https://myaccount.google.com/apppasswords with
# "Mail" + your machine name. Two-factor auth must be enabled first.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx


# ── AI provider (one selector, provider-agnostic model name) ────────────────
# Under the hood: pipeline/AI/lm.py builds a `<litellm-prefix>/<model>`
# string for DSPy. To switch providers, change AI_PROVIDER and (optionally)
# SUMMARIZE_MODEL — no other env edits needed.
#
# [ai] Which provider to call. One of:
#        ollama     local via Ollama (default; no API key needed)
#        anthropic  Claude via Anthropic API
#        openai     GPT via OpenAI API
#        gemini     Google Gemini API
#        minimax    Minimax API
AI_PROVIDER=ollama

# [ai] Provider-native model name (no prefix). Optional — each provider
# has a sane default if you leave this unset.
#   ollama:    e.g. qwen3:8b, gemma2:latest, llama3.1:70b
#   anthropic: e.g. claude-sonnet-4-6, claude-opus-4-7
#   openai:    e.g. gpt-4o-mini, gpt-4o, o1-mini
#   gemini:    e.g. gemini-2.0-flash, gemini-1.5-pro
#   minimax:   e.g. abab6.5s-chat
SUMMARIZE_MODEL=gemma4:latest

# [ai] Embedding model for dedup (T2/T3) and relation linking. Routed to
# the same provider as AI_PROVIDER by default (override via EMBEDDING_PROVIDER
# below — useful when AI_PROVIDER=anthropic|minimax, which have no embedding
# API). Optional, has a per-provider default.
#   ollama: qwen3-embedding:latest, embeddinggemma:latest
#   openai: text-embedding-3-small, text-embedding-3-large
#   gemini: text-embedding-004
#   voyage: voyage-3, voyage-3-large
#   cohere: embed-english-v3.0
EMBEDDING_MODEL=qwen3-embedding:latest

# [ai] Optional. Route embeddings through a different provider than
# AI_PROVIDER. Default: same as AI_PROVIDER. Required when AI_PROVIDER
# is anthropic or minimax (neither has an embedding API).
# Supported: ollama, openai, gemini, voyage, cohere.
# EMBEDDING_PROVIDER=ollama


# ── Provider credentials (set the ones matching your AI_PROVIDER) ───────────
# [ai] Ollama daemon URL. Used iff AI_PROVIDER=ollama (or EMBEDDING_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434

# [ai] Anthropic. Required iff AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# [ai] OpenAI. Required iff AI_PROVIDER=openai (or EMBEDDING_PROVIDER=openai).
# OPENAI_API_KEY=sk-...

# [ai] Google Gemini. Required iff AI_PROVIDER=gemini (or EMBEDDING_PROVIDER=gemini).
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# [ai] Minimax. Required iff AI_PROVIDER=minimax.
# MINIMAX_API_KEY=...

# [ai] Voyage AI (embedding-only provider). Required iff EMBEDDING_PROVIDER=voyage.
# VOYAGE_API_KEY=...

# [ai] Cohere. Required iff EMBEDDING_PROVIDER=cohere.
# COHERE_API_KEY=...


# ── Git export (news-archive) ───────────────────────────────────────────────
# [export] HTTPS clone URL of the downstream archive repo that the PWA
# pulls from. Use https://... so FEED_REPO_PAT can authenticate.
FEED_REPO_URL=https://github.com/yourname/news-archive.git
# [export] GitHub personal-access token with `contents: write` on the
# news-archive repo. Fine-grained PAT recommended. Treat as a secret —
# the export step writes it into the remote URL at push time.
FEED_REPO_PAT=github_pat_xxx


# ── Twitter ingestion (Playwright + persistent Chrome profile) ──────────────
# [twitter] Backend for Twitter ingestion. Default `playwright` opens X with
# a persistent Chrome profile. Set `hermes_tweet` to fetch configured handles
# through Hermes Tweet/Xquik instead.
TWITTER_BACKEND=playwright
# [twitter] Absolute path to a Chrome/Chromium binary. Playwright launches
# this with --user-data-dir=$CHROME_PROFILE_DIR so cookies persist between
# runs (so you only log in to X once).
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
#   Windows: leave blank, default lookup hits Program Files
CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# [twitter] Where the persistent profile lives. If unset, the code picks
# an OS-specific default under your home dir. First run will create it
# empty — log in via `bash scripts/setup_agent.sh`.
CHROME_PROFILE_DIR=
# [twitter] Run Playwright headless. Default `true`. Set `false` when
# debugging or doing the initial X login.
TWITTER_HEADLESS=true
# [twitter:hermes_tweet] Required only when TWITTER_BACKEND=hermes_tweet.
# XQUIK_API_KEY=xq_...
# XQUIK_BASE_URL=https://xquik.com/api/v1


# ── Telegram notifier ───────────────────────────────────────────────────────
# [notify] Bot token from @BotFather. Treat as a secret — anyone with
# this token can post as your bot.
TELEGRAM_BOT_TOKEN=
# [notify] Numeric chat ID to receive run summaries. For a personal chat,
# message your bot once then GET https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy `result[0].message.chat.id`. For a group, add the bot then
# repeat — group IDs are negative.
TELEGRAM_CHAT_ID=
